# Optional: copy this file to .env beside compose.yaml.
# The default demo works without .env. Do not commit .env or real credentials.
WEB_PORT=8080
ORACLE_PORT=1521
CINEMA_DEMO=1

# A different project name creates a SEPARATE database volume; it does not migrate data.
# COMPOSE_PROJECT_NAME=huflit-cinema-my-demo

# Local demo passwords already have defaults in compose.yaml.
# If customizing, set these BEFORE the first launch of a NEW volume.
# Keep them unchanged when restarting an existing volume.
# CINEMA_DB_PASSWORD must start with a letter and contain 12-64 letters/digits/underscores.
# ORACLE_ADMIN_PASSWORD=ChooseYourLocalAdminPassword
# CINEMA_DB_PASSWORD=ChooseYourLocalAppPassword
# CINEMA_JWT_SECRET=ChooseALongRandomLocalSigningSecret
